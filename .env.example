# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local atau nilai asli apa pun.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (skrip seed, fungsi admin). Jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (lihat docs/PRD bagian 8.2) ---
# Pilihan: gemini | groq | anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Batas panggilan AI per pengguna per jam
AI_RATE_LIMIT_PER_HOUR=20

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
