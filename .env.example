# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local atau nilai asli apa pun.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya dipakai di server (skrip seed, fungsi admin). Jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Kata sandi akun demo (penjual.demo@example.com, pembeli.demo@example.com).
# Dipakai `npm run akun:demo` / `npm run seed`, dan kalau diisi di server (juga di
# Vercel), halaman Masuk menampilkan tombol "Coba akun demo". Minimal 8 karakter.
DEMO_PASSWORD=

# --- AI (lihat docs/PRD bagian 8.2) ---
# Pilihan saat ini: gemini | openrouter (groq dan anthropic belum ada adapternya)
AI_PROVIDER=gemini
# OpenRouter: key dari https://openrouter.ai/keys, model contoh anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Batas panggilan AI per pengguna per jam
AI_RATE_LIMIT_PER_HOUR=20

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video opsional untuk tur panduan (tombol "Tonton video" di kartu pembuka tur).
# URL YouTube atau path file di public/ (mis. /tutorial-pembeli.mp4).
# Kosong = tur sorotan tetap jalan, hanya tanpa tombol video.
NEXT_PUBLIC_VIDEO_TUTORIAL_PENJUAL=
NEXT_PUBLIC_VIDEO_TUTORIAL_PEMBELI=
