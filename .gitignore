# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets never go to git, only the template does
.env*
!.env.example

# vercel
.vercel

# supabase local
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# competition files that must not be published
GUIDEBOOK-*.pdf
*.pdf

# editor
.vscode/*
!.vscode/extensions.json
.idea
